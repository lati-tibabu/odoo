<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="todo_page">
        <t t-call="web.layout">
            <link rel="stylesheet" type="text/css" href="/custom_todo/static/src/css/todo.css"/>
            <div class="container mt-4 todo-container">
                <h2>Custom To-Do App</h2>

                <!-- Tabs -->
                <ul class="nav nav-tabs mb-4" id="todoTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a t-att-class="'nav-link ' + (filter == 'all' and 'active' or '')" 
                           href="/todo?filter=all" role="tab">All Tasks</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a t-att-class="'nav-link ' + (filter == 'pending' and 'active' or '')" 
                           href="/todo?filter=pending" role="tab">Pending</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a t-att-class="'nav-link ' + (filter == 'done' and 'active' or '')" 
                           href="/todo?filter=done" role="tab">Completed</a>
                    </li>
                </ul>

                <!-- Add Task Form -->
                <div class="card mb-4 todo-form-card">
                    <div class="card-header">
                        <h5 class="mb-0">Add New Task</h5>
                    </div>
                    <div class="card-body">
                        <form action="/todo/add" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="name" class="form-label">Task Name *</label>
                                        <input type="text" name="name" id="name" class="form-control" required="required"/>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="category" class="form-label">Category</label>
                                        <input type="text" name="category" id="category" class="form-control"/>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="description" class="form-label">Description</label>
                                <textarea name="description" id="description" class="form-control" rows="3"></textarea>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="priority" class="form-label">Priority</label>
                                        <select name="priority" id="priority" class="form-select">
                                            <option value="low">Low</option>
                                            <option value="medium" selected="selected">Medium</option>
                                            <option value="high">High</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="due_date" class="form-label">Due Date</label>
                                        <input type="date" name="due_date" id="due_date" class="form-control"/>
                                    </div>
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-primary">Add Task</button>
                        </form>
                    </div>
                </div>

                <!-- Tasks List -->
                <div class="card task-list">
                    <div class="card-header">
                        <h5 class="mb-0">Tasks (<t t-esc="len(tasks)"/>)</h5>
                    </div>
                    <div class="card-body">
                        <t t-if="not tasks">
                            <div class="empty-state">
                                <i class="fa fa-check-circle"></i>
                                <h4>No tasks found</h4>
                                <p>Add your first task above!</p>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="list-group">
                                <t t-foreach="tasks" t-as="task">
                                    <div t-attf-class="list-group-item task-card #{task.is_done and 'task-completed' or ''}">
                                        <div class="d-flex w-100 justify-content-between">
                                            <div class="flex-grow-1">
                                                <h5 class="mb-1 task-title">
                                                    <t t-esc="task.name"/>
                                                    <t t-if="task.is_done">
                                                        <span class="badge bg-success ms-2">Done</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-warning text-dark ms-2">Pending</span>
                                                    </t>
                                                </h5>
                                                <t t-if="task.description">
                                                    <p class="mb-1"><t t-esc="task.description"/></p>
                                                </t>
                                                <div class="mb-2 task-meta">
                                                    <t t-if="task.category">
                                                        <small class="me-3">
                                                            <i class="fa fa-tag"></i> <t t-esc="task.category"/>
                                                        </small>
                                                    </t>
                                                    <small class="me-3">
                                                        <i class="fa fa-exclamation-triangle"></i>
                                                        <span t-att-class="'badge priority-' + task.priority">
                                                            <t t-esc="dict([('low', 'Low'), ('medium', 'Medium'), ('high', 'High')])[task.priority]"/>
                                                        </span>
                                                    </small>
                                                    <t t-if="task.due_date">
                                                        <small class="me-3">
                                                            <i class="fa fa-calendar"></i>
                                                            <t t-esc="task.due_date.strftime('%Y-%m-%d')"/>
                                                        </small>
                                                    </t>
                                                    <small>
                                                        <i class="fa fa-clock-o"></i>
                                                        <t t-esc="task.create_date.strftime('%Y-%m-%d %H:%M')"/>
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center task-actions">
                                                <form t-att-action="'/todo/toggle/' + str(task.id)" method="post" class="me-2">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" t-att-class="'btn btn-sm ' + (task.is_done and 'btn-outline-success' or 'btn-outline-warning')">
                                                        <t t-if="task.is_done">
                                                            <i class="fa fa-undo"></i> Undo
                                                        </t>
                                                        <t t-else="">
                                                            <i class="fa fa-check"></i> Done
                                                        </t>
                                                    </button>
                                                </form>
                                                <a t-att-href="'/todo/edit/' + str(task.id)" class="btn btn-sm btn-outline-primary me-2">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>
                                                <form t-att-action="'/todo/delete/' + str(task.id)" method="post" class="me-2">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Are you sure you want to delete this task?')">
                                                        <i class="fa fa-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="todo_edit_page">
        <t t-call="web.layout">
            <link rel="stylesheet" type="text/css" href="/custom_todo/static/src/css/todo.css"/>
            <div class="container mt-4 todo-container">
                <h2>Edit Task</h2>
                
                <div class="card edit-form-container">
                    <div class="card-body">
                        <form t-att-action="'/todo/edit/' + str(task.id)" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="name" class="form-label">Task Name *</label>
                                        <input type="text" name="name" id="name" class="form-control" 
                                               t-att-value="task.name" required="required"/>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="category" class="form-label">Category</label>
                                        <input type="text" name="category" id="category" class="form-control" 
                                               t-att-value="task.category"/>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="description" class="form-label">Description</label>
                                <textarea name="description" id="description" class="form-control" rows="3" t-att-value="task.description"></textarea>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="priority" class="form-label">Priority</label>
                                        <select name="priority" id="priority" class="form-select">
                                            <option value="low" t-att-selected="task.priority == 'low'">Low</option>
                                            <option value="medium" t-att-selected="task.priority == 'medium'">Medium</option>
                                            <option value="high" t-att-selected="task.priority == 'high'">High</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="due_date" class="form-label">Due Date</label>
                                        <input type="date" name="due_date" id="due_date" class="form-control" 
                                               t-att-value="task.due_date and task.due_date.strftime('%Y-%m-%d')"/>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Update Task</button>
                                <a href="/todo" class="btn btn-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
